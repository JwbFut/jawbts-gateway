# Base URL of jawbts-api. No trailing slash. Baked into the static bundle at
# build time, so rebuild after changing it.
#
# Local development (npm run dev, port 3001). This is also the dev fallback
# when the variable is unset.
VITE_API_BASE_URL=http://localhost:3000
#
# Production: set this explicitly when building, or omit it to use the
# built-in production fallback (https://api.jawbts.org). Do not ship a build
# that still points at localhost.
# VITE_API_BASE_URL=https://api.jawbts.org

# Optional display name shown in the header/footer.
VITE_SITE_NAME="Jawbts"

# Terminal welcome banner. The build hash is normally injected from the
# hosting/CI commit (VERCEL_GIT_COMMIT_SHA, GITHUB_SHA, CI_COMMIT_SHA); set it
# explicitly to override, for example in a local release build.
# VITE_BUILD_HASH=abc1234
#
# Copyright/license line printed under the version. The project is
# GPL-3.0-only (see LICENSE). Override only if a deployment needs a different
# notice.
# VITE_LICENSE_NOTICE="(c) 2026 Jawbts. Licensed under the GNU General Public License v3.0; see LICENSE."
